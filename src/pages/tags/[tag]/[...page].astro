---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Paginator, PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, getTagsWithCount, sortMDByDate } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import config from '@/site-config'

export const prerender = true

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getBlogCollection()
  const allPostsByDate = sortMDByDate<'blog'>(allPosts)
  const tags = getTagsWithCount(allPostsByDate)
  const collectionsCount = allPosts.length

  return tags.flatMap(([tag]) => {
    const filterPosts = allPostsByDate.filter((post) => post.data.tags.includes(tag))
    return paginate(filterPosts, {
      pageSize: config.content.blogPageSize,
      // Astro matches decoded Unicode paths while preserving encoded URL delimiters.
      params: { tag: decodeURI(encodeURIComponent(tag)) },
      props: { tag, tags, collectionsCount }
    })
  })
}

interface Props {
  page: Page<CollectionEntry<'blog'>>
  tag: string
  tags: [string, number][]
  collectionsCount: number
}

const { page, tag, tags, collectionsCount } = Astro.props

const meta = {
  description: `View posts tagged ${tag}`,
  title: tag
}

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: `← Previous Posts`,
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: `Next Posts →`,
      url: page.url.next
    }
  })
}
---

<PageLayout {meta}>
  <Button title='Back' href='/blog' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 flex items-end gap-x-2 text-3xl font-medium'>
        {tag}
      </h1>
    </div>

    <nav aria-label='Blog tags' class='mb-6'>
      <ul class='flex flex-wrap gap-x-4 gap-y-1 text-sm'>
        <li>
          <a href='/blog' class='text-primary underline-offset-4 hover:underline'>
            All <span class='text-muted-foreground'>({collectionsCount})</span>
          </a>
        </li>
        {
          tags.map(([name, count]) => (
            <li>
              <a
                href={`/tags/${encodeURIComponent(name)}`}
                aria-current={name === tag ? 'page' : undefined}
                class={name === tag ? 'font-semibold text-primary' : 'text-primary underline-offset-4 hover:underline'}
                data-astro-prefetch
              >
                {name} <span class='font-normal text-muted-foreground'>({count})</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <section id='content' class='animate' aria-label='Blog post list'>
      <ul class='flex flex-col gap-y-3 text-start'>
        {page.data.map((post) => <PostPreview {post} detailed />)}
      </ul>
      <Paginator {...paginationProps} />
    </section>
  </main>
</PageLayout>
