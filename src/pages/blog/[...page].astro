---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Paginator, PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, getTagsWithCount, sortMDByDate } from 'astro-pure/server'
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import config from '@/site-config'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getBlogCollection()
  const tags = getTagsWithCount(allPosts)
  const collections = sortMDByDate<'blog'>(allPosts)
  const collectionsCount = collections.length
  return paginate(collections, {
    pageSize: config.content.blogPageSize,
    props: { tags, collectionsCount }
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  tags: [string, number][]
  collectionsCount: number
}

const { page, tags, collectionsCount } = Astro.props

const meta = {
  description: 'Some posts or archives of my blog',
  title: 'Blog'
}

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: `← Previous Posts`,
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: `Next Posts →`,
      url: page.url.next
    }
  })
}
---

<PageLayout {meta}>
  <Button title='Back' href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <h1 class='sr-only'>Blog</h1>
    <div class='grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8'>
      <section aria-label='Blog posts list' class='animate' id='content'>
        {
          page.data.length === 0 ? (
            <p>No posts yet.</p>
          ) : (
            <>
              {/* header */}
              <div class='mb-3 flex flex-col justify-between text-sm sm:mb-5 sm:flex-row'>
                <span class='text-muted-foreground'>
                  Page {page.currentPage} - Showing {page.data.length} of {collectionsCount} posts
                </span>
                <a aria-label='View all blog by years' href='/archives' data-astro-prefetch>
                  View all posts by years →
                </a>
              </div>
              {/* posts */}
              <ul class='flex flex-col gap-y-4 text-start'>
                {page.data.map((post) => (
                  <PostPreview {post} detailed />
                ))}
              </ul>
              <Paginator {...paginationProps} />
            </>
          )
        }
      </section>

      {/* sidebar */}
      <aside class='animate' id='sidebar'>
        <h2 class='mb-4 flex items-center text-lg font-medium'>
          <Icon name='tag-2' class='me-2' />
          Tags
        </h2>
        <nav aria-label='Blog tags'>
          <ul class='flex flex-col gap-y-1.5 text-sm'>
            <li>
              <a href='/blog' aria-current='page' class='font-semibold text-primary'>
                All <span class='font-normal text-muted-foreground'>({collectionsCount})</span>
              </a>
            </li>
            {
              tags.map(([tag, count]) => (
                <li>
                  <a
                    href={`/tags/${encodeURIComponent(tag)}`}
                    class='text-primary underline-offset-4 hover:underline'
                    data-astro-prefetch
                  >
                    {tag} <span class='text-muted-foreground'>({count})</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>
    </div>
  </main>
</PageLayout>
