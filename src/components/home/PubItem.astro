---
import type { CvItem } from '@/data/cv'

interface Props {
  pub: CvItem
}

const { pub } = Astro.props
const badge = pub.award // from the CV source (sections/publications.yml)
// Bold the site owner's name, keeping any equal-contribution marker.
const authors = (pub.authors ?? [])
  .map((a) => a.replace(/^Junoh Kang(\*?)$/, '<strong>Junoh Kang$1</strong>'))
  .join(', ')

// Show only Paper, Project, and Code. Paper opens alphaXiv (built from the arXiv link, fast),
// else the published PDF. The PDF CV uses the same rule (cv/export.rb).
const byLabel = (label: string) => pub.links?.find((l) => l.label === label)?.url
const arxivId = byLabel('arXiv')?.match(
  /arxiv\.org\/(?:abs|pdf)\/([^/?#]+?)(?:\.pdf)?(?:[?#].*)?$/
)?.[1]
const paper = arxivId
  ? `https://www.alphaxiv.org/abs/${arxivId}`
  : (byLabel('arXiv') ?? byLabel('Paper'))
const links = [
  { label: 'Paper', url: paper },
  { label: 'Project', url: byLabel('Project') },
  { label: 'Code', url: byLabel('Code') }
].filter((l): l is { label: string; url: string } => Boolean(l.url))
const underReview = pub.venue === 'Under review'
---

<li class='pub'>
  {/* A heading with the paper id, so search results can link to each paper */}
  <h3 class='title' id={pub.id}>{pub.title}</h3>
  <p class='authors' set:html={authors} />
  {/* One meta line: venue and award on the left, links pushed to the right edge. */}
  <div class='meta'>
    <span>
      <span class:list={['venue', { review: underReview }]}>{pub.venue}</span>
      {
        badge && (
          <>
            <span class='dot'>·</span>
            <span class='award'>{badge}</span>
          </>
        )
      }
    </span>
    {
      links.length > 0 && (
        <span class='links'>
          {links.map((l, i) => (
            <>
              {i > 0 && <span class='slash'>/</span>}
              <a href={l.url} target='_blank' rel='noopener' set:text={l.label} />
            </>
          ))}
        </span>
      )
    }
  </div>
</li>

<script>
  // Marks the paper named by the URL fragment with the `arrived` class: a fading band and a thin
  // left bar. A class (not :target) is used so the home page can change the URL with
  // history.pushState, which does not update :target and does not make the browser jump.
  function arrive(hash: string) {
    document.querySelectorAll('.pub.arrived').forEach((p) => p.classList.remove('arrived'))
    const pub = hash ? document.getElementById(decodeURIComponent(hash.slice(1)))?.closest('.pub') : null
    if (!pub) return
    void (pub as HTMLElement).offsetWidth // restart the fade when the same paper is marked again
    pub.classList.add('arrived')
  }
  arrive(location.hash)
  window.addEventListener('hashchange', () => arrive(location.hash))
  // The home page's pointer-height scroll announces its target this way
  window.addEventListener('paper-arrive', (e) => arrive((e as CustomEvent<string>).detail))
  // A default jump to the paper that is already the fragment fires no hashchange; mark it again
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]')
    if (link && link.hash === location.hash) arrive(link.hash)
  })
</script>

<style>
  .pub {
    padding-block: 0.9rem;
    border-bottom: 1px solid hsl(var(--border));
  }
  .pub:last-child {
    border-bottom: 0;
  }
  /* A paper reached through an in-page link (e.g. #kang2024ogdm; see the script above) gets a light
     gray band under its text that fades out over two seconds, so the reader sees where they landed. */
  .pub {
    position: relative;
    isolation: isolate;
  }
  .pub.arrived::before {
    content: '';
    position: absolute;
    inset: 0 -0.75rem;
    z-index: -1;
    background: hsl(var(--muted));
    pointer-events: none;
    animation: target-fade 2s ease-out forwards;
  }
  @keyframes target-fade {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
  /* A thin navy bar stays at the left of the reached paper while it is the URL fragment */
  .pub.arrived::after {
    content: '';
    position: absolute;
    top: 0.6rem;
    bottom: 0.6rem;
    left: -0.75rem;
    width: 2px;
    border-radius: 1px;
    background: hsl(var(--primary));
    pointer-events: none;
  }
  .title {
    /* Keep the title clear of the sticky header when jumped to */
    scroll-margin-top: 5.5rem;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .authors {
    margin-top: 0.2rem;
    font-size: 0.875rem;
    color: hsl(var(--muted-foreground));
  }
  .authors :global(strong) {
    color: hsl(var(--foreground));
    font-weight: 600;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin-top: 0.3rem;
    font-size: 0.8125rem;
  }
  .venue {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    /* Not a link, so not navy: a warm orange that complements the navy links */
    color: #ad5f1c;
  }
  .venue.review {
    font-weight: 500;
    font-style: italic;
    color: hsl(var(--muted-foreground));
  }
  .dot {
    margin-inline: 0.35rem;
    color: hsl(var(--muted-foreground));
  }
  .award {
    font-weight: 500;
    color: #8a5a00;
  }
  .links a {
    font-weight: 500;
    color: hsl(var(--primary));
    text-decoration: underline;
    text-decoration-color: hsl(var(--primary) / 0.3);
    text-underline-offset: 3px;
  }
  .links a:hover {
    text-decoration-color: hsl(var(--primary));
  }
  .slash {
    margin-inline: 0.4rem;
    color: #b0b0b0;
  }
  /* Narrow screens: links drop below the venue, left-aligned */
  @media (max-width: 640px) {
    .meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
