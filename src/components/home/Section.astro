---
import { cn } from 'astro-pure/utils'

// `note`: optional small gray text at the right end of the heading row.
const { class: className, title, id, note } = Astro.props
---

<section id={id} class={cn('flex flex-col gap-y-4', className)}>
  <div class='flex items-baseline justify-between gap-x-4'>
    <h2 class='label'>{title}</h2>
    {note && <span class='text-xs text-muted-foreground'>{note}</span>}
  </div>
  <div class='flex flex-col gap-y-3'>
    <slot />
  </div>
</section>

<style>
  /* Small uppercase label; a hairline fills the rest of the row */
  .label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: hsl(var(--foreground));
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.9rem;
  }
  .label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: hsl(var(--border));
  }
</style>
