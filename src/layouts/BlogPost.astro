---
import { existsSync } from 'node:fs'
import { dirname, join } from 'node:path'
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { MediumZoom } from 'astro-pure/advanced'
import { ArticleBottom, Copyright, Hero, TOC } from 'astro-pure/components/pages'
import PageLayout from '@/layouts/ContentLayout.astro'
import config from 'virtual:config'

interface Props {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
}

const {
  post: { id, data, filePath },
  posts,
  headings,
  remarkPluginFrontmatter
} = Astro.props

const {
  description,
  heroImage,
  publishDate,
  title,
  updatedDate
} = data

const socialImage = heroImage
  ? typeof heroImage.src === 'string'
    ? heroImage.src
    : heroImage.src.src
  : config.socialCard
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()

// Post footer (copyright card, sponsor strip, previous/next links) is turned off; set true to restore
const showPostFooter = false

// TOC lists only the post's top heading level (usually ##), without nested subsections
const topDepth = Math.min(...headings.map((h) => h.depth))
const tocHeadings = headings.filter((h) => h.depth === topDepth)

// The supplied posts exclude drafts in production; keep the visibility rule explicit here too.
const seriesPosts = data.series
  ? posts
      .filter((entry) => entry.data.series === data.series && (!import.meta.env.PROD || !entry.data.draft))
      .sort((a, b) =>
        (a.data.seriesOrder ?? Infinity) - (b.data.seriesOrder ?? Infinity) ||
        a.data.publishDate.getTime() - b.data.publishDate.getTime() ||
        a.id.localeCompare(b.id)
      )
  : []

// `slides:` names a deck beside index.md. Post files are served at /blog/post/<YYYYMMDD>/<file>;
// slides-thumb.png (made by scripts/slides-thumb.sh) is the card's preview image.
const assetBase = `/blog/post/${publishDate.toISOString().slice(0, 10).replaceAll('-', '')}`
const hasThumb = !!filePath && existsSync(join(dirname(filePath), 'slides-thumb.png'))
const slides = data.slides
  ? {
      href: `${assetBase}/${data.slides}`,
      kind: data.slides.toLowerCase().endsWith('.pdf') ? 'PDF' : 'Web',
      thumb: hasThumb ? `${assetBase}/slides-thumb.png` : undefined
    }
  : undefined
---

<PageLayout
  meta={{ articleDate, description, ogImage: socialImage, title }}
  back='/blog'
>
  <Fragment slot='sidebar'>
    {!!tocHeadings.length && <TOC headings={tocHeadings} />}
    {seriesPosts.length > 1 && (
      <nav aria-label={`${data.series} series`} class='series-nav' data-pagefind-ignore>
        <h2 class='series-eyebrow'>SERIES</h2>
        <p class='series-title'>{data.series}</p>
        <ol role='list'>
          {seriesPosts.map((entry, index) => {
            const prefix = `${data.series} (${entry.data.seriesOrder}): `
            const label = entry.data.title.startsWith(prefix)
              ? entry.data.title.slice(prefix.length)
              : entry.data.title
            return (
              <li value={entry.data.seriesOrder}>
                <a href={`/blog/${entry.id}`} aria-current={entry.id === id ? 'page' : undefined}>
                  <span class='series-number' aria-hidden='true'>{String(entry.data.seriesOrder ?? index + 1).padStart(2, '0')}</span>
                  <span>{label}</span>
                </a>
              </li>
            )
          })}
        </ol>
      </nav>
    )}
  </Fragment>

  <Hero {data} {remarkPluginFrontmatter} slot='header' />
  {/* Slide deck card under the title, the same on every screen size */}
  {
    slides && (
      <a href={slides.href} target='_blank' rel='noopener' class='slides-card' slot='header' data-pagefind-ignore>
        {slides.thumb && <img src={slides.thumb} alt='' class='thumb' loading='lazy' />}
        <span class='body'>
          <span class='name'>Slides</span>
          <span class='kind'>{slides.kind}</span>
          <span class='open'>Open slides ↗</span>
        </span>
      </a>
    )
  }

  <slot />

  {
    showPostFooter && (
      <Fragment slot='bottom'>
        {/* Copyright */}
        <Copyright {data} />
        {/* Article recommend */}
        <ArticleBottom collections={posts} {id} class='mt-3 sm:mt-6' />
      </Fragment>
    )
  }

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>

{config.integ.mediumZoom.enable && <MediumZoom />}

<style>
  .series-nav {
    margin: 3rem 0.25rem 1rem 0;
    padding: 1rem;
    border: 1px solid hsl(var(--border) / 0.65);
    border-radius: 0.875rem;
    background: hsl(var(--muted) / 0.3);
  }
  .series-eyebrow {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: hsl(var(--muted-foreground));
  }
  .series-title {
    margin: 0.5rem 0 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
    text-wrap: balance;
  }
  .series-nav ol {
    display: grid;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
    margin: 0 -0.5rem;
  }
  .series-nav li {
    list-style: none;
  }
  .series-nav li::marker {
    content: '';
  }
  .series-nav a {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    gap: 0.5rem;
    padding: 0.65rem 0.5rem;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: hsl(var(--muted-foreground));
    overflow-wrap: anywhere;
    transition: background-color 150ms, color 150ms;
  }
  .series-number {
    padding-top: 0.1rem;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.65;
  }
  .series-nav a:hover {
    background: hsl(var(--muted) / 0.7);
    color: hsl(var(--foreground));
  }
  .series-nav a[aria-current='page'] {
    background: hsl(var(--primary) / 0.08);
    color: hsl(var(--primary));
    font-weight: 500;
  }
  .series-nav a:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 2px;
  }

  .slides-card {
    margin-top: 1.5rem;
    display: flex;
    gap: 1rem;
    align-items: center;
    max-width: 26rem;
    padding: 0.6rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.75rem;
  }
  .slides-card:hover {
    border-color: hsl(var(--primary) / 0.4);
  }
  .thumb {
    width: 8.5rem;
    margin: 0;
    border: 1px solid hsl(var(--border));
    border-radius: 0.4rem;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.875rem;
  }
  .name {
    font-weight: 600;
  }
  .kind {
    font-size: 0.8125rem;
    color: hsl(var(--muted-foreground));
  }
  .open {
    margin-top: 0.3rem;
    font-weight: 500;
    color: hsl(var(--primary));
  }
</style>
