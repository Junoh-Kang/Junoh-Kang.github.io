---
import { existsSync } from 'node:fs'
import { dirname, join } from 'node:path'
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { MediumZoom } from 'astro-pure/advanced'
import { ArticleBottom, Copyright, Hero, TOC } from 'astro-pure/components/pages'
import PageLayout from '@/layouts/ContentLayout.astro'
import config from 'virtual:config'

interface Props {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
}

const {
  post: { id, data, filePath },
  posts,
  headings,
  remarkPluginFrontmatter
} = Astro.props

const {
  description,
  heroImage,
  publishDate,
  title,
  updatedDate
} = data

const socialImage = heroImage
  ? typeof heroImage.src === 'string'
    ? heroImage.src
    : heroImage.src.src
  : config.socialCard
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()

// Post footer (copyright card, sponsor strip, previous/next links) is turned off; set true to restore
const showPostFooter = false

// TOC lists only the post's top heading level (usually ##), without nested subsections
const topDepth = Math.min(...headings.map((h) => h.depth))
const tocHeadings = headings.filter((h) => h.depth === topDepth)

// `slides:` names a deck beside index.md. Post files are served at /blog/post/<YYYYMMDD>/<file>;
// slides-thumb.png (made by scripts/slides-thumb.sh) is the card's preview image.
const assetBase = `/blog/post/${publishDate.toISOString().slice(0, 10).replaceAll('-', '')}`
const hasThumb = !!filePath && existsSync(join(dirname(filePath), 'slides-thumb.png'))
const slides = data.slides
  ? {
      href: `${assetBase}/${data.slides}`,
      kind: data.slides.toLowerCase().endsWith('.pdf') ? 'PDF' : 'Web',
      thumb: hasThumb ? `${assetBase}/slides-thumb.png` : undefined
    }
  : undefined
---

<PageLayout
  meta={{ articleDate, description, ogImage: socialImage, title }}
  back='/blog'
>
  {!!tocHeadings.length && <TOC headings={tocHeadings} slot='sidebar' />}

  <Hero {data} {remarkPluginFrontmatter} slot='header' />
  {/* Slide deck card under the title, the same on every screen size */}
  {
    slides && (
      <a href={slides.href} target='_blank' rel='noopener' class='slides-card' slot='header'>
        {slides.thumb && <img src={slides.thumb} alt='' class='thumb' loading='lazy' />}
        <span class='body'>
          <span class='name'>Slides</span>
          <span class='kind'>{slides.kind}</span>
          <span class='open'>Open slides ↗</span>
        </span>
      </a>
    )
  }

  <slot />

  {
    showPostFooter && (
      <Fragment slot='bottom'>
        {/* Copyright */}
        <Copyright {data} />
        {/* Article recommend */}
        <ArticleBottom collections={posts} {id} class='mt-3 sm:mt-6' />
      </Fragment>
    )
  }

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>

{config.integ.mediumZoom.enable && <MediumZoom />}

<style>
  .slides-card {
    margin-top: 1.5rem;
    display: flex;
    gap: 1rem;
    align-items: center;
    max-width: 26rem;
    padding: 0.6rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.75rem;
  }
  .slides-card:hover {
    border-color: hsl(var(--primary) / 0.4);
  }
  .thumb {
    width: 8.5rem;
    margin: 0;
    border: 1px solid hsl(var(--border));
    border-radius: 0.4rem;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.875rem;
  }
  .name {
    font-weight: 600;
  }
  .kind {
    font-size: 0.8125rem;
    color: hsl(var(--muted-foreground));
  }
  .open {
    margin-top: 0.3rem;
    font-weight: 500;
    color: hsl(var(--primary));
  }
</style>
