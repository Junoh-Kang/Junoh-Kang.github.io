---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import type { CollectionEntry, CollectionKey } from 'astro:content'

import { cn } from '../../utils'
import { FormattedDate } from '../user'

type Props<T extends CollectionKey> = {
  post: CollectionEntry<T>
  detailed?: boolean
  showCategory?: boolean
  class?: string
}

const { post, detailed = false, showCategory = true, class: className } = Astro.props
const { id, data } = post
const postDate = data.updatedDate ?? data.publishDate
type PreviewMetadata = {
  heroImage?: {
    src: ImageMetadata
    alt?: string
    inferSize?: boolean
    width?: number
    height?: number
    color?: string
  }
  language?: string
  pin?: boolean
}
const previewData = data as typeof data & Partial<PreviewMetadata>
---

<li
  class={cn('post-preview', className)}
  style={detailed &&
    previewData.heroImage?.color &&
    `--preview-highlight:color-mix(in srgb,${previewData.heroImage.color} 40%,hsl(var(--foreground)/var(--un-text-opacity,1)));
    --preview-highlight-bg:hsl(from ${previewData.heroImage.color} h s l/20%)`}
>
  <div
    class={cn(
      'block w-full relative group rounded-2xl border bg-background transition-colors ease-in-out px-5 py-2.5 hover:bg-muted hover:text-primary',
      detailed && 'max-sm:px-4 sm:py-5',
      detailed && previewData.heroImage && 'max-md:pt-24'
    )}
  >
    {
      detailed && previewData.heroImage && (
        <Image
          alt={previewData.heroImage.alt || data.title}
          class='cover-image absolute end-0 top-0 z-0 h-2/3 w-full rounded-2xl object-cover opacity-50 transition-opacity duration-300 group-hover:opacity-70 md:h-full md:w-3/5'
          loading='eager'
          {...previewData.heroImage}
        />
      )
    }
    <div class={cn('flex flex-col gap-1', !detailed && 'sm:flex-row sm:items-center')}>
      {!detailed && postDate && <FormattedDate class='min-w-[95px] text-xs' date={postDate} />}

      {/* title */}
      <div class='flex justify-between flex-grow'>
        <a
          href={`/blog/${id}`}
          data-astro-prefetch
          class={cn(
            'after:absolute after:inset-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4',
            detailed && 'font-medium'
          )}
        >
          {previewData.pin && <span class='text-primary me-1'>[Pin]</span>}
          {data.draft && <span class='text-red-500 me-1'>(Draft)</span>}
          {data.title}
        </a>
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='16'
          height='16'
          viewBox='0 0 24 24'
          fill='none'
          stroke-width='2.5'
          stroke-linecap='round'
          stroke-linejoin='round'
          class='preview-redirect my-1 stroke-muted-foreground group-hover:stroke-primary'
          ><line
            x1='5'
            y1='12'
            x2='19'
            y2='12'
            class='translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100'
          ></line><polyline
            points='12 5 19 12 12 19'
            class='translate-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1'
          ></polyline></svg
        >
      </div>
      {
        detailed && (
          <>
            {/* desc */}
            <p
              class={cn(
                'line-clamp-2 text-sm text-muted-foreground sm:line-clamp-3',
                previewData.heroImage && 'sm:me-24'
              )}
            >
              {data.description}
            </p>
            <div class='mt-2 flex flex-wrap items-center gap-x-2 text-xs text-muted-foreground'>
              {postDate && <FormattedDate date={postDate} />}
              {showCategory && 'category' in data && (
                <>
                  {postDate && <span aria-hidden='true'>·</span>}
                  <a
                    href={`/categories/${data.category.toLowerCase()}`}
                    class='relative z-10 underline-offset-4 hover:underline hover:text-primary focus-visible:underline'
                    aria-label={`View ${data.category} posts`}
                    data-astro-prefetch
                  >
                    {data.category}
                  </a>
                </>
              )}
              {previewData.language && (
                <>
                  <span aria-hidden='true'>·</span>
                  <span>{previewData.language}</span>
                </>
              )}
            </div>
          </>
        )
      }
    </div>
  </div>

  <style>
    .post-preview {
      --preview-highlight-final: var(
        --preview-highlight,
        hsl(var(--primary) / var(--un-text-opacity, 1))
      );
    }
    .post-preview:hover {
      & > div {
        background-color: var(
          --preview-highlight-bg,
          hsl(var(--muted) / var(--un-bg-opacity, 1))
        ) !important;
      }
      & > div {
        color: var(--preview-highlight-final) !important;
      }
      & > div .preview-redirect {
        stroke: var(--preview-highlight-final) !important;
      }
    }
    .cover-image {
      -webkit-mask-image: -webkit-linear-gradient(left, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      -webkit-mask-image: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      mask-image: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
    }

    @media (max-width: 768px) {
      .cover-image {
        -webkit-mask-image: -webkit-linear-gradient(
          bottom,
          rgba(0, 0, 0, 0) 0%,
          rgba(0, 0, 0, 1) 100%
        );
        -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
        mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      }
    }
  </style>
</li>
